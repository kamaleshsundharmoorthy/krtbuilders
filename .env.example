# MongoDB connection string (MongoDB Atlas → Connect → Drivers)
DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/redstone-homes

# Long random string used to sign admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public address of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob token for photo uploads (Vercel → Storage → Blob). Leave empty locally
# to store uploads in the /media folder instead.
BLOB_READ_WRITE_TOKEN=

# --- Optional: email alerts for new enquiries (and admin password resets) ---
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Google "App password", not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Redstone Homes Website
# Who receives new-enquiry alerts (comma separated for several people)
ENQUIRY_NOTIFY_EMAIL=
SMTP_HOST=
   SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
   SMTP_FROM_NAME=Redstone Homes Website
ENQUIRY_NOTIFY_EMAIL=
